# PostgreSQL
POSTGRES_DB=tigre_fight
POSTGRES_USER=tigre_fight
POSTGRES_PASSWORD=change-me
DATABASE_URL=jdbc:postgresql://postgres:5432/tigre_fight

# API
API_PORT=8080

# Asaas - backend only
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# TotalPass - backend only; names may be adjusted to official partner credentials
TOTALPASS_ENABLED=false
TOTALPASS_PARTNER_API_KEY=
TOTALPASS_PLACE_API_KEY=

# Wellhub - backend only; configure only with official partner credentials/docs
WELLHUB_ENABLED=false
WELLHUB_CLIENT_ID=
WELLHUB_CLIENT_SECRET=

# Tigre Fight Access
ACCESS_API_BASE_URL=http://localhost:8080
ACCESS_DEVICE_ID=
ACCESS_DEVICE_SECRET=
ACCESS_SQLITE_PATH=./runtime/tigre-fight-access.db
